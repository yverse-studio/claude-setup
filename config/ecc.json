{
  "$comment": "Curated subset of Everything Claude Code (affaan-m/ECC). The full plugin adds ~45k tokens to every session; this subset keeps what fits yskills' stack. Refresh with: node scripts/sync-ecc.mjs <path-to-ECC-checkout>",
  "repo": "https://github.com/affaan-m/ECC",
  "version": "2.2.3",
  "commit": "c05b2d6614f62f6db0047669aa4eefb223d478f9",
  "npmPackage": "ecc-universal@2.2.3",
  "skills": [
    "product-lens",
    "vue-patterns",
    "nuxt4-patterns",
    "vite-patterns",
    "api-design",
    "database-migrations",
    "e2e-testing",
    "i18n-sync",
    "seo",
    "docker-patterns"
  ],
  "agents": [
    "planner",
    "architect",
    "code-reviewer",
    "typescript-reviewer",
    "vue-reviewer",
    "security-reviewer",
    "database-reviewer",
    "build-error-resolver",
    "e2e-runner",
    "refactor-cleaner",
    "silent-failure-hunter",
    "doc-updater",
    "a11y-architect",
    "performance-optimizer",
    "seo-specialist"
  ],
  "rules": [
    "typescript",
    "vue",
    "nuxt",
    "web"
  ],
  "hooks": {
    "profile": "standard",
    "disabled": [
      "pre:bash:auto-tmux-dev",
      "pre:bash:tmux-reminder",
      "pre:bash:gateguard-fact-force",
      "pre:edit-write:gateguard-fact-force"
    ]
  },
  "ruleExcludes": [
    "typescript/hooks.md",
    "vue/hooks.md",
    "nuxt/hooks.md",
    "web/hooks.md"
  ],
  "$comment_ruleExcludes": "The common rules pack is not vendored (it contradicted CLAUDE.md and loaded every session); the */hooks.md files only explain how to wire formatter hooks."
}
