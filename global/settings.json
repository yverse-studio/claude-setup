{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:nuxt.com)",
      "WebFetch(domain:vuejs.org)",
      "WebFetch(domain:pinia.vuejs.org)",
      "WebFetch(domain:i18n.nuxtjs.org)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:www.typescriptlang.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.stripe.com)",
      "WebFetch(domain:www.gesetze-im-internet.de)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run verify)",
      "Bash(npx vitest run:*)",
      "Bash(npx vue-tsc --noEmit:*)",
      "Bash(node --check:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(npm publish:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npm run deploy:*)",
      "Bash(npm run ship:*)",
      "Bash(firebase deploy:*)",
      "Bash(vercel --prod:*)",
      "Bash(rm -rf:*)",
      "Bash(wrangler delete:*)",
      "Bash(npx wrangler delete:*)",
      "Bash(wrangler d1 execute:*)",
      "Bash(npx wrangler d1 execute:*)",
      "Bash(wrangler d1 delete:*)",
      "Bash(wrangler secret:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Read(**/.dev.vars)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(~/.npmrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/.wrangler/**)",
      "Read(~/.wrangler/**)",
      "Edit(**/.dev.vars)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Bash(wrangler login:*)",
      "Bash(npx wrangler login:*)",
      "Bash(wrangler logout:*)",
      "Bash(npx wrangler logout:*)",
      "Bash(git push* --force*main*)",
      "Bash(git push* --force*master*)",
      "Bash(git push* -f *main*)",
      "Bash(git push* -f *master*)",
      "Bash(git push* +main*)",
      "Bash(git push* +master*)",
      "Bash(git push*main* --force*)",
      "Bash(git push*master* --force*)",
      "Bash(git push*main* -f*)",
      "Bash(git push*master* -f*)",
      "Bash(git push* --delete*main*)",
      "Bash(git push* --delete*master*)",
      "Bash(git push* :main*)",
      "Bash(git push* :master*)",
      "Bash(git push* --mirror*)",
      "Bash(git -C* push*--force*main*)",
      "Bash(git -C* push*-f *main*)",
      "Bash(git -c* push*--force*main*)",
      "Bash(git -c* push*-f *main*)",
      "Bash(git push* -fu *main*)",
      "Bash(git push* -uf *main*)"
    ]
  },
  "effortLevel": "high",
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": true,
  "cleanupPeriodDays": 90,
  "env": {
    "ECC_CONTEXT_MONITOR_COST_WARNINGS": "off",
    "ECC_SESSION_START_MAX_CHARS": "4000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  }
}
