{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": "These deny rules apply only in a one-repository session. A project thread with claude-setup plus the app repo ignores them (per the Projects docs); that is fine because the thread's own rules come from the cloud environment.",
  "permissions": {
    "allow": [
      "mcp__claude-code-remote__add_repo"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Read(**/.dev.vars)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(~/.npmrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/.wrangler/**)",
      "Read(~/.wrangler/**)",
      "Edit(**/.dev.vars)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Bash(wrangler login:*)",
      "Bash(npx wrangler login:*)",
      "Bash(wrangler logout:*)",
      "Bash(npx wrangler logout:*)",
      "Bash(git push* --force*main*)",
      "Bash(git push* --force*master*)",
      "Bash(git push* -f *main*)",
      "Bash(git push* -f *master*)",
      "Bash(git push* +main*)",
      "Bash(git push* +master*)",
      "Bash(git push*main* --force*)",
      "Bash(git push*master* --force*)",
      "Bash(git push*main* -f*)",
      "Bash(git push*master* -f*)",
      "Bash(git push* --delete*main*)",
      "Bash(git push* --delete*master*)",
      "Bash(git push* :main*)",
      "Bash(git push* :master*)",
      "Bash(git push* --mirror*)",
      "Bash(git -C* push*--force*main*)",
      "Bash(git -C* push*-f *main*)",
      "Bash(git -c* push*--force*main*)",
      "Bash(git -c* push*-f *main*)",
      "Bash(git push* -fu *main*)",
      "Bash(git push* -uf *main*)",
      "Bash(wrangler deploy *)",
      "Bash(npx wrangler deploy *)",
      "Bash(npm run deploy *)",
      "Bash(npm run ship *)",
      "Bash(firebase deploy *)",
      "Bash(vercel --prod *)",
      "Bash(git push* origin main*)",
      "Bash(git push* origin master*)",
      "Bash(git push*:main*)",
      "Bash(git push*:master*)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push*refs/heads/main*)",
      "Bash(git -C* push* origin main*)",
      "Bash(git -C* push*:main*)",
      "Bash(git -C* push * main)",
      "Bash(git -C* push*refs/heads/main*)",
      "Bash(git -C* push*+main*)",
      "Bash(git -C* push*--delete*main*)",
      "Bash(gh workflow run delete-project*--ref*)",
      "Bash(gh workflow run delete-project* -r *)"
    ]
  }
}
